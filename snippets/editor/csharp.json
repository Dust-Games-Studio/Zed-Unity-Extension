      "\t\tvar item = _property.GetArrayElementAtIndex(index);",
      "\t\tEditorGUI.PropertyField(rect, item);",
      "\t\t$0",
      "\t}",
      "",
      "\tpublic override void OnInspectorGUI() {",
      "\t\tserializedObject.Update();",
      "\t\tEditorGUILayout.Space();",
